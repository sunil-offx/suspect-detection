# ==============================================================================
# CrimeSketch AI — Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before starting services.
# ==============================================================================

# Database Configuration (PostgreSQL 14+)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/crimesketch

# Authentication & Security Core
JWT_SECRET=supersecret-crimesketch-jwt-token-key-32bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin Seeding (Used by scripts/seed_admin.py)
ADMIN_EMAIL=admin@crimesketch.com
ADMIN_PASSWORD=AdminSecurePassword123!

# Storage Configuration (Private Opaque Token Vault)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# Case Retention & Maintenance
RETENTION_DAYS=90

# AI Provider Integrations (All optional; system degrades gracefully to HTTP 503)
# LLM Analysis Provider (openai | anthropic | none)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Audio Transcription Provider (openai | local | none)
WHISPER_PROVIDER=none
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# Forensic Image Composite Provider (huggingface | replicate | fal | stability | none)
IMAGE_PROVIDER=none
IMAGE_API_KEY=
IMAGE_MODEL=mrfakename/Z-Image-Turbo

# Explicit Development Fixtures (Only for offline dev & CI; never mocks silently)
DEV_FIXTURES=0

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
